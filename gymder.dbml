Project gymder {
  database_type: 'PostgreSQL'
  Note: 'Gymder data model. SQL migrations must enable row-level security and maintain updated_at with a BEFORE UPDATE trigger on mutable tables.'
}

Enum record_status {
  active
  inactive
}

Enum profile_role {
  student
  coach
}

Enum coaching_modality {
  online
  in_person
  hybrid
}

Enum ad_event_type {
  impression
  click
}

Enum contact_request_status {
  pending
  accepted
  declined
  cancelled
}

Enum plan_tier {
  start
  plus
  pro
}

Enum notification_type {
  contact_request_created
  contact_request_resolved
  review_created
}

Table profiles {
  id uuid [pk, not null, note: 'Supabase Auth user ID. Add the foreign key to auth.users.id in the SQL migration.']
  full_name varchar(150) [not null]
  role profile_role [not null, default: 'student']
  avatar_path text [note: 'Object path in the Supabase Storage avatar bucket.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Supabase Auth owns email, password credentials and session lifecycle.'
}

Table coaches {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  profile_id uuid [not null, unique]
  specialty varchar(150)
  bio text
  city varchar(100)
  modality coaching_modality
  starting_price decimal(10,2) [check: `starting_price >= 0`]
  trial_class_available boolean [not null, default: false]
  trial_class_price decimal(10,2) [check: `trial_class_price >= 0`]
  currency_code varchar(3) [check: `currency_code ~ '^[A-Z]{3}$'`, note: 'ISO 4217 currency code for the listed prices.']
  status record_status [not null, default: 'active']
  is_verified boolean [not null, default: false]
  verified_at timestamptz
  verified_by uuid [note: 'Profile of the administrator who verified the coach.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `(starting_price IS NULL AND trial_class_price IS NULL) OR currency_code IS NOT NULL` [name: 'ck_coaches_price_currency']
    `trial_class_price IS NULL OR trial_class_available` [name: 'ck_coaches_trial_price_availability']
    `(is_verified AND verified_at IS NOT NULL AND verified_by IS NOT NULL) OR (NOT is_verified AND verified_at IS NULL AND verified_by IS NULL)` [name: 'ck_coaches_verification_audit']
  }

  indexes {
    specialty
    modality
    is_verified
    status
  }

  Note: 'Administrator-only writes apply to is_verified, verified_at and verified_by.'
}

Table plans {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  coach_id uuid [not null]
  title varchar(150) [not null, check: `btrim(title) <> ''`]
  description text
  price decimal(10,2) [not null, check: `price >= 0`]
  currency_code varchar(3) [not null, check: `currency_code ~ '^[A-Z]{3}$'`]
  status record_status [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (coach_id, status)
    (coach_id, tier) [unique]
  }

  Note: 'One plan per tier (start, plus, pro) per coach.'
}

Table coach_media {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  coach_id uuid [not null]
  image_url text [not null]
  sort_order integer [not null, default: 0, check: `sort_order >= 0`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (coach_id, sort_order)
  }

  Note: 'Coach gallery images. Phase 1 profile photos use profiles.avatar_path.'
}

Table favorites {
  profile_id uuid [not null]
  coach_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (profile_id, coach_id) [pk]
    coach_id
  }

  Note: 'Only student profiles may favorite. Adding creates the row; removing deletes it.'
}

Table contact_requests {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  student_id uuid [not null]
  coach_id uuid [not null]
  message text
  status contact_request_status [not null, default: 'pending']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz

  checks {
    `(status = 'pending' AND resolved_at IS NULL) OR (status <> 'pending' AND resolved_at IS NOT NULL AND resolved_at >= created_at)` [name: 'ck_contact_requests_resolution']
  }

  indexes {
    (student_id, status)
    (coach_id, status)
  }

  Note: 'The sender must be a student and the target an active coach. Use a partial unique index for pending pairs. Accepting creates or reuses the conversation.'
}

Table conversations {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  student_id uuid [not null]
  coach_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (student_id, coach_id) [unique]
    coach_id
  }
}

Table messages {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  conversation_id uuid [not null]
  sender_id uuid [not null]
  body text [not null, check: `length(btrim(body)) BETWEEN 1 AND 2000`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  read_at timestamptz

  checks {
    `read_at IS NULL OR read_at >= created_at` [name: 'ck_messages_read_at']
  }

  indexes {
    (conversation_id, created_at)
  }

  Note: 'The sender must be the student or coach profile in the conversation. The recipient sets read_at.'
}

Table reviews {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  coach_id uuid [not null]
  student_id uuid [not null]
  rating smallint [not null, check: `rating BETWEEN 1 AND 5`]
  comment text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (student_id, coach_id) [unique]
    coach_id
  }

  Note: 'A student with a conversation with the coach may leave one review. Coach rating and reviews_count are derived (view coach_stats).'
}

Table notifications {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  recipient_id uuid [not null]
  notification_type notification_type [not null]
  contact_request_id uuid
  review_id uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  read_at timestamptz

  checks {
    `(notification_type IN ('contact_request_created', 'contact_request_resolved') AND contact_request_id IS NOT NULL AND review_id IS NULL) OR (notification_type = 'review_created' AND review_id IS NOT NULL AND contact_request_id IS NULL)` [name: 'ck_notifications_source']
    `read_at IS NULL OR read_at >= created_at` [name: 'ck_notifications_read_at']
  }

  indexes {
    (recipient_id, created_at)
    (recipient_id, notification_type, contact_request_id) [unique]
    (recipient_id, review_id) [unique]
  }

  Note: 'Triggers create these rows: request created -> coach, request accepted/declined -> student, review created -> coach. Only the recipient can read the notice or set read_at.'
}

Table ads {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  advertiser_name varchar(150) [not null]
  title varchar(200) [not null]
  image_url text
  destination_url text [not null]
  status record_status [not null, default: 'active']
  starts_at timestamptz
  ends_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `starts_at IS NULL OR ends_at IS NULL OR starts_at < ends_at` [name: 'ck_ads_schedule']
  }
}

Table ad_events {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  ad_id uuid [not null]
  profile_id uuid
  event_type ad_event_type [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (ad_id, created_at)
    profile_id
  }

  Note: 'Ad events are append-only.'
}

Table refresh_tokens {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  profile_id uuid [not null]
  token_hash varchar(255) [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  revoked_at timestamptz

  checks {
    `expires_at > created_at` [name: 'ck_refresh_tokens_expiry']
    `revoked_at IS NULL OR revoked_at >= created_at` [name: 'ck_refresh_tokens_revocation']
  }

  indexes {
    profile_id
  }

  Note: 'Legacy design kept for reference. Supabase Auth manages refresh tokens. Exclude this table from app migrations.'
}

Ref: profiles.id - coaches.profile_id
Ref: coaches.verified_by >? profiles.id
Ref: plans.coach_id > coaches.id
Ref: coach_media.coach_id > coaches.id
Ref: favorites.profile_id > profiles.id
Ref: favorites.coach_id > coaches.id
Ref: contact_requests.student_id > profiles.id
Ref: contact_requests.coach_id > coaches.id
Ref: conversations.student_id > profiles.id
Ref: conversations.coach_id > coaches.id
Ref: messages.conversation_id > conversations.id
Ref: messages.sender_id > profiles.id
Ref: reviews.coach_id > coaches.id
Ref: reviews.student_id > profiles.id
Ref: notifications.recipient_id > profiles.id
Ref: notifications.contact_request_id >? contact_requests.id
Ref: notifications.review_id >? reviews.id
Ref: ad_events.ad_id > ads.id
Ref: ad_events.profile_id >? profiles.id
Ref: refresh_tokens.profile_id > profiles.id
